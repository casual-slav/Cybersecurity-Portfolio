// One IP failing against many accounts
// MITRE ATT&CK:    T1110.003 Brute Force: Password Spraying
// Summary:         Finds IPs with failed sign-ins against many different accounts,
//                  then checks whether any sign-in from those IPs succeeded.
// Failure codes: 50126 invalid username or password
//                50053 account locked
//                81016 Seamless SSO invalid request
// Change the lookback, threshold and codes as required
let lookback         = 1d;
let accountThreshold = 5;
let failureCodes     = dynamic(["50126", "50053", "81016"]);
let AllSignins = union isfuzzy=true SigninLogs, AADNonInteractiveUserSignInLogs
    | where TimeGenerated > ago(lookback);
let SprayIPs = AllSignins
    | where ResultType in (failureCodes)
    | summarize TargetedAccounts = dcount(UserPrincipalName) by IPAddress
    | where TargetedAccounts > accountThreshold
    | project IPAddress;
AllSignins
| where IPAddress in (SprayIPs)
| summarize
    StartTime          = min(TimeGenerated),
    EndTime            = max(TimeGenerated),
    TargetedAccounts   = dcountif(UserPrincipalName, ResultType in (failureCodes)),
    FailedAttempts     = countif(ResultType in (failureCodes)),
    SuccessfulSignins  = countif(ResultType == "0"),
    SuccessfulAccounts = make_set_if(UserPrincipalName, ResultType == "0", 50),
    SampleAccounts     = make_set(UserPrincipalName, 50),
    FailureCodes       = make_set_if(ResultType, ResultType != "0", 10),
    UserAgents         = make_set(UserAgent, 20),
    Country            = take_any(Location)
    by IPAddress
| extend Severity = iff(SuccessfulSignins > 0, "High", "Medium")
| order by SuccessfulSignins desc, TargetedAccounts desc